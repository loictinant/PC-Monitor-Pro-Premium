<Application
    x:Class="PCMonitor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6FA" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D9E1EC" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#152033" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#087A66" />
                    <SolidColorBrush x:Key="BlueBrush" Color="#3869C8" />
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#E1E7EF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#10151E" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#171E2A" />
                    <SolidColorBrush x:Key="PanelBorderBrush" Color="#273243" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#93A0B4" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EDF6" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#63D6BD" />
                    <SolidColorBrush x:Key="BlueBrush" Color="#80AAFF" />
                    <SolidColorBrush x:Key="ChartGridBrush" Color="#273243" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="MetricCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="900" />
                <Setter Property="Foreground" Value="{ThemeResource MutedTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window
    x:Class="PCMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PC Monitor Pro Premium">
    <Grid x:Name="WindowRoot" Background="{ThemeResource AppBackgroundBrush}">
        <NavigationView x:Name="RootNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="226"
                        SelectionChanged="OnNavigationSelectionChanged"
                        Background="{ThemeResource AppBackgroundBrush}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Vue d’ensemble" Tag="dashboard" IsSelected="True">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Paramètres" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Alertes Pro" Tag="alerts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Message" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Historique" Tag="history">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="À propos" Tag="about">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Offre Pro" Tag="pro">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Shop" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid>
                    <Grid x:Name="DashboardView" Margin="30,24,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Vue d’ensemble" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock Text="Les performances de votre PC, en un coup d’œil." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Background="#1D2D32" BorderBrush="#2B4B4A" BorderThickness="1" CornerRadius="12" Padding="11,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusText" Text="Surveillance active" Foreground="#B4E7D8" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Button x:Name="RefreshNowButton" Content="Actualiser" Click="OnRefreshNowClicked" />
                                <Button x:Name="PauseButton" Content="Pause" Click="OnPauseClicked" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="PROCESSEUR" Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock Text="CPU" HorizontalAlignment="Right" Foreground="{ThemeResource AccentBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="CpuValueText" Text="— %" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                        <TextBlock Text="utilisation" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                    </Grid>
                                    <ProgressBar x:Name="CpuProgressBar" Maximum="100" Value="0" Height="5" />
                                    <TextBlock Text="Charge globale du système" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="MÉMOIRE" Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock Text="RAM" HorizontalAlignment="Right" Foreground="{ThemeResource BlueBrush}" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock x:Name="MemoryValueText" Text="— %" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <ProgressBar x:Name="MemoryProgressBar" Maximum="100" Value="0" Height="5" />
                                    <TextBlock x:Name="MemoryDetailText" Text="Lecture des compteurs Windows…" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="STOCKAGE" Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock Text="DISQUES" HorizontalAlignment="Right" Foreground="#F4C87A" FontWeight="SemiBold" />
                                    </Grid>
                                    <TextBlock x:Name="DiskValueText" Text="—" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <ProgressBar x:Name="DiskProgressBar" Maximum="100" Value="0" Height="5" />
                                    <TextBlock x:Name="DiskDetailText" Text="Volumes fixes prêts" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="RÉSEAU" Style="{StaticResource EyebrowStyle}" />
                                        <TextBlock Text="LIVE" HorizontalAlignment="Right" Foreground="#C79BFF" FontWeight="SemiBold" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="↓" Foreground="{ThemeResource AccentBrush}" FontSize="20" />
                                        <TextBlock x:Name="DownloadValueText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="↑" Foreground="{ThemeResource BlueBrush}" FontSize="20" />
                                        <TextBlock x:Name="UploadValueText" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="Débits agrégés reçus / envoyés" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="4" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.65*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Padding="20">
                                <Grid RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Activité du processeur" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Historique de cette session · 60 derniers relevés" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="ChartCurrentText" Grid.Column="1" Text="— %" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Canvas x:Name="CpuChartCanvas" Grid.Row="1" MinHeight="150" SizeChanged="OnCpuChartSizeChanged" />
                                    <Grid Grid.Row="2">
                                        <TextBlock Text="0 %" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" />
                                        <TextBlock x:Name="ChartTimeRangeText" Text="En attente des relevés" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Padding="20">
                                <Grid RowSpacing="13">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Volumes" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Espace utilisé sur les disques fixes" FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock x:Name="DiskCountText" Text="0 lecteur" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="DiskVolumesPanel" Spacing="14" />
                                    </ScrollViewer>
                                    <TextBlock Grid.Row="2" Text="Les lecteurs amovibles et réseau sont masqués." Foreground="{ThemeResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="6">
                            <TextBlock x:Name="LastUpdatedText" Text="En attente du premier relevé…" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" />
                            <TextBlock Text="Collecte locale · aucune donnée envoyée" HorizontalAlignment="Right" Foreground="{ThemeResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsView" Visibility="Collapsed" Margin="30,24,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="Paramètres" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="Choisissez le rythme de mise à jour du tableau de bord." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                        </StackPanel>
                        <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}" Padding="22">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Intervalle de rafraîchissement" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <TextBlock Text="Un intervalle plus long réduit l'activité de collecte." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="SettingsRefreshIntervalComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnRefreshIntervalChanged">
                                    <ComboBoxItem Content="Chaque seconde" Tag="1" />
                                    <ComboBoxItem Content="Toutes les 2 secondes" Tag="2" />
                                    <ComboBoxItem Content="Toutes les 5 secondes" Tag="5" />
                                    <ComboBoxItem Content="Toutes les 10 secondes" Tag="10" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Grid.Row="4" Style="{StaticResource MetricCardStyle}" Padding="22">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Réduire ou fermer dans la zone de notification" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <TextBlock Text="La réduction ou le bouton Fermer masque la fenêtre. Utilise l’icône près de l’horloge pour rouvrir ou quitter." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="OnMinimizeToTrayToggled" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="6" Style="{StaticResource MetricCardStyle}" Padding="22">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Démarrer avec Windows" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="StartupStatusText" Text="Activé par défaut pour ce compte Windows." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartWithWindowsToggle" Grid.Column="1" VerticalAlignment="Center" Toggled="OnStartWithWindowsToggled" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="8" Style="{StaticResource MetricCardStyle}" Padding="22">
                            <Grid ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Thème de l’application" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <TextBlock Text="Automatique suit le thème clair ou sombre de Windows." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeChoiceComboBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="OnThemeChoiceChanged">
                                    <ComboBoxItem Content="Automatique (Windows)" Tag="Automatic" />
                                    <ComboBoxItem Content="Clair" Tag="Light" />
                                    <ComboBoxItem Content="Sombre" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Grid.Row="10" Style="{StaticResource MetricCardStyle}" Padding="22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Confidentialité" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                <TextBlock Text="Les compteurs sont lus sur cet appareil. L’historique reste en mémoire pendant cette session et s’efface à la fermeture. L’application ne demande pas de compte et n’envoie pas de données." Foreground="{ThemeResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="AlertsView" Visibility="Collapsed" Margin="30,24,30,24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Alertes Pro" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                    <TextBlock Text="Les alertes personnalisées font partie des fonctions Premium (PRO). Elles sont disponibles après activation de la licence Microsoft Store; l’EXE renvoie vers la fiche Store." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Style="{StaticResource MetricCardStyle}" Padding="20">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="Alertes personnalisées (PRO)" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Les alertes CPU, mémoire et disque se débloquent avec la version PRO payante." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="AlertsEnabledToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="Verrouillé" OnContent="PRO" Toggled="OnProFeatureToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Padding="20">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Processeur (PRO)" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Alerte de charge CPU avec seuil personnalisable." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="CpuAlertToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="Verrouillé" OnContent="PRO" Toggled="OnProFeatureToggled" />
                                        <ComboBox x:Name="CpuThresholdComboBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" SelectedIndex="3" SelectionChanged="OnAlertThresholdChanged">
                                            <ComboBoxItem Content="70 %" Tag="70" /><ComboBoxItem Content="75 %" Tag="75" /><ComboBoxItem Content="80 %" Tag="80" /><ComboBoxItem Content="85 %" Tag="85" /><ComboBoxItem Content="90 %" Tag="90" /><ComboBoxItem Content="95 %" Tag="95" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Padding="20">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Mémoire vive (PRO)" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Alerte d’utilisation mémoire avec seuil personnalisable." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="MemoryAlertToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="Verrouillé" OnContent="PRO" Toggled="OnProFeatureToggled" />
                                        <ComboBox x:Name="MemoryThresholdComboBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" SelectedIndex="3" SelectionChanged="OnAlertThresholdChanged">
                                            <ComboBoxItem Content="70 %" Tag="70" /><ComboBoxItem Content="75 %" Tag="75" /><ComboBoxItem Content="80 %" Tag="80" /><ComboBoxItem Content="85 %" Tag="85" /><ComboBoxItem Content="90 %" Tag="90" /><ComboBoxItem Content="95 %" Tag="95" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource MetricCardStyle}" Padding="20">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="Disques (PRO)" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                            <TextBlock Text="Alerte séparée pour chaque disque avec seuil personnalisable." FontSize="12" Foreground="{ThemeResource MutedTextBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="DiskAlertToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="Verrouillé" OnContent="PRO" Toggled="OnProFeatureToggled" />
                                        <ComboBox x:Name="DiskThresholdComboBox" Grid.Column="2" VerticalAlignment="Center" IsEnabled="False" SelectedIndex="4" SelectionChanged="OnAlertThresholdChanged">
                                            <ComboBoxItem Content="70 %" Tag="70" /><ComboBoxItem Content="75 %" Tag="75" /><ComboBoxItem Content="80 %" Tag="80" /><ComboBoxItem Content="85 %" Tag="85" /><ComboBoxItem Content="90 %" Tag="90" /><ComboBoxItem Content="95 %" Tag="95" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="AlertsStatusText" Text="Aucune alerte n’est envoyée dans la version gratuite." Foreground="{ThemeResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,0,2,10" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="AboutView" Visibility="Collapsed" Margin="30,24,30,24">
                        <StackPanel Spacing="12">
                            <TextBlock Text="PC Monitor Pro Premium" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="Version 0.2.2 · version de test" FontSize="14" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="Développé par LOIC TINANT" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" />
                            <TextBlock Text="GitHub et site internet : à venir." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" />
                            <TextBlock Text="Le tableau de bord gratuit est disponible. PC Monitor Pro Premium déverrouillera les fonctions marquées (PRO); celles signalées « à venir » ne sont pas encore disponibles." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="620" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProView" Visibility="Collapsed" Margin="30,24,30,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="PC Monitor Pro Premium" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                            <TextBlock Text="Gardez gratuitement les indicateurs essentiels. Débloquez les fonctions marquées (PRO) avec un achat unique." FontSize="13" Foreground="{ThemeResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="2" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource MetricCardStyle}" Padding="22">
                                <StackPanel Spacing="11">
                                    <TextBlock Text="GRATUIT" Foreground="{ThemeResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="L’essentiel au quotidien" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="CPU, mémoire, disques et réseau en direct" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" />
                                    <TextBlock Text="Rafraîchissement configurable" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" />
                                    <TextBlock Text="Historique de session léger" Foreground="{ThemeResource MutedTextBrush}" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Padding="22" BorderBrush="{ThemeResource PanelBorderBrush}">
                                <StackPanel Spacing="11">
                                    <TextBlock Text="VERSION PREMIUM · ACHAT UNIQUE" Foreground="#9A5CC7" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Toutes les fonctions marquées (PRO)" Foreground="{ThemeResource PrimaryTextBrush}" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="Un seul achat pour les fonctions Premium livrées dans l’application. Certaines sont encore en préparation." Foreground="{ThemeResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                    <Button Content="Historique persistant jusqu’à 24 h (PRO) · à venir" Tag="persistent-history" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Alertes CPU, mémoire et disques (PRO)" Tag="alerts" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Graphiques avancés et intervalle étendu (PRO) · à venir" Tag="advanced-charts" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Export CSV et rapports (PRO) · à venir" Tag="csv-export" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Surveillance GPU et mémoire vidéo (PRO) · à venir" Tag="hardware-sensors" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Températures et ventilateurs (PRO) · selon le matériel · à venir" Tag="hardware-sensors" Click="OnProFeatureClicked" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                    <Button Content="Découvrir PC Monitor Pro Premium" Click="OnShowProOfferClicked" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="L’achat unique Premium débloquera les fonctions marquées (PRO). Dans cette version, seules les alertes personnalisées sont prêtes; les fonctions indiquées « à venir » ne sont pas encore déverrouillables." Foreground="{ThemeResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid x:Name="HistoryView" Visibility="Collapsed" Margin="30,24,30,24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="VersionHistoryPanel" Spacing="14" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>

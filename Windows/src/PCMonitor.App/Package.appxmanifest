<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="TINANTLOIC.PCMonitorProPremium" Publisher="CN=D67E21A8-DC00-45EF-86D1-375158FB659F" Version="0.3.0.0" ProcessorArchitecture="$PLATFORM$" />
  <Properties>
    <DisplayName>PC Monitor Pro Premium</DisplayName>
    <PublisherDisplayName>TINANT LOIC</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="fr-FR" />
  </Resources>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="PC Monitor Pro Premium" Description="Tableau de bord système local" BackgroundColor="#111827" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="PCMonitorPro.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="PCMonitorProStartupTask" Enabled="true" DisplayName="PC Monitor Pro Premium" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PCMonitorPro</AssemblyName>
    <RootNamespace>PCMonitor.App</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion>0.3.0</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxPackageIdentityName>TINANTLOIC.PCMonitorProPremium</AppxPackageIdentityName>
    <AppxPackageDisplayName>PC Monitor Pro Premium</AppxPackageDisplayName>
    <AppxPackagePublisher>CN=D67E21A8-DC00-45EF-86D1-375158FB659F</AppxPackagePublisher>
    <AppxPackageVersion>0.3.0.0</AppxPackageVersion>
    <AppxManifest>Package.appxmanifest</AppxManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PCMonitorProPremiumTest)' == 'true'">
    <DefineConstants>$(DefineConstants);PCMONITORPRO_PREMIUM_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9457" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <ProjectReference Include="..\PCMonitor.Core\PCMonitor.Core.csproj" />
    <ProjectReference Include="..\ProductLicensing.Abstractions\ProductLicensing.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="PCMonitorPro.StoreListingProductId" Value="$(StoreListingProductId)" />
    <AssemblyMetadata Include="PCMonitorPro.ProAddOnStoreId" Value="$(ProAddOnStoreId)" />
    <AssemblyMetadata Include="PCMonitorPro.ProAddOnProductId" Value="$(ProAddOnProductId)" />
  </ItemGroup>
</Project>
